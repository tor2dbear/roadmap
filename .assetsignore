# Kept out of the served static bundle (assets.directory is the repo root).
# Only the board itself ships: index.html, app.js, styles.css, data/, ROADMAP.md.
.git
.gitignore
.assetsignore
wrangler.jsonc
package.json
package-lock.json
README.md
CLAUDE.md
CONVENTION.md
AGENTS.md
sources.json
board.config.json
roadmap
scripts
tests
templates
agents
.github
node_modules

# Everything .gitignore ignores, so does the bundle. The two lists answer different
# questions — "is this part of the project" and "is this part of the site" — but the
# first answer implies the second: a file git does not track is never something to
# publish. They drifted once already: `*.tmp.*` was gitignored in the same commit that
# removed probe.tmp.mjs, which left a local `wrangler deploy` (npm run deploy) free to
# upload the next one while the guard, reading the git index, saw nothing.
# .sources/ is the worst of them — the harvester clones the source repos into it.
.sources
.DS_Store
scratchpad-*.png
*.log
*.tmp.*
