{
  // Static-assets Worker for the roadmap board at https://roadmap.tor2dbear.com.
  // Pattern B (committed deploy config) per tor2dbear.com/CONVENTIONS.md — the
  // fleet default. Like the workshop itself there is NO build step: the board
  // (index.html + app.js + styles.css + the generated data/) is served straight
  // from the repo root, and .assetsignore keeps the harvester code and config
  // out of the served bundle.
  //
  // Content freshness: scripts/harvest.mjs runs in GitHub Actions (hourly + on
  // push), clones the source repos, builds data/ fresh, and deploys it here with
  // `wrangler deploy` (see .github/workflows/sync.yml). The data is never
  // committed back — CI is the only thing that deploys, so the Worker's own Git
  // build must stay disconnected in the Cloudflare dashboard.
  //
  // `routes` with custom_domain claims roadmap.tor2dbear.com and lets wrangler
  // create it and its DNS record on the tor2dbear.com zone at first deploy. An
  // existing A/AAAA/CNAME on that name blocks it; a TXT does not.
  "name": "roadmap",
  "compatibility_date": "2026-08-15",
  "preview_urls": true,
  "assets": {
    "directory": ".",
  },
  "routes": [
    { "pattern": "roadmap.tor2dbear.com", "custom_domain": true },
  ],
}
